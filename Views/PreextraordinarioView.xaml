<UserControl x:Class="Registro_de_Calificaciones_Jose_Ma._Morelos_y_Pavon.Views.PreextraordinarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="800">

	<Grid Background="#F1F5F9">

		<Border Background="White"
                BorderBrush="#D7DEE8"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12">

			<Grid>

				<Grid.Resources>

					<SolidColorBrush x:Key="AppBlue"
                                     Color="#1B365D" />

					<SolidColorBrush x:Key="AppBlueSoft"
                                     Color="#EFF6FF" />

					<SolidColorBrush x:Key="AppBlueSoftBorder"
                                     Color="#BFDBFE" />

					<Style x:Key="RoundedTextBoxStyle"
                           TargetType="TextBox">

						<Setter Property="Background"
                                Value="White" />

						<Setter Property="BorderBrush"
                                Value="#CBD5E1" />

						<Setter Property="BorderThickness"
                                Value="1" />

						<Setter Property="Foreground"
                                Value="#0F172A" />

						<Setter Property="Padding"
                                Value="8,2" />

						<Setter Property="VerticalContentAlignment"
                                Value="Center" />

						<Setter Property="Template">

							<Setter.Value>

								<ControlTemplate TargetType="TextBox">

									<Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8"
                                            SnapsToDevicePixels="True">

										<ScrollViewer x:Name="PART_ContentHost"
                                                      Margin="0"
                                                      VerticalAlignment="Center" />

									</Border>

									<ControlTemplate.Triggers>

										<Trigger Property="IsMouseOver"
                                                 Value="True">

											<Setter TargetName="Bd"
                                                    Property="BorderBrush"
                                                    Value="#93C5FD" />

										</Trigger>

										<Trigger Property="IsKeyboardFocused"
                                                 Value="True">

											<Setter TargetName="Bd"
                                                    Property="BorderBrush"
                                                    Value="{StaticResource AppBlue}" />

											<Setter TargetName="Bd"
                                                    Property="BorderThickness"
                                                    Value="1.5" />

										</Trigger>

										<Trigger Property="IsEnabled"
                                                 Value="False">

											<Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="#F3F4F6" />

											<Setter TargetName="Bd"
                                                    Property="BorderBrush"
                                                    Value="#CBD5E1" />

											<Setter Property="Foreground"
                                                    Value="#94A3B8" />

										</Trigger>

									</ControlTemplate.Triggers>

								</ControlTemplate>

							</Setter.Value>

						</Setter>

					</Style>

					<Style x:Key="PreGradeBlock"
                           TargetType="Border">

						<Setter Property="Background"
                                Value="{StaticResource AppBlueSoft}" />

						<Setter Property="BorderBrush"
                                Value="{StaticResource AppBlueSoftBorder}" />

						<Setter Property="BorderThickness"
                                Value="1" />

						<Setter Property="CornerRadius"
                                Value="8" />

						<Setter Property="Padding"
                                Value="10,4" />

						<Setter Property="HorizontalAlignment"
                                Value="Center" />

						<Setter Property="VerticalAlignment"
                                Value="Center" />

					</Style>

					<Style x:Key="InfoButtonStyle"
                           TargetType="Button">

						<Setter Property="Width"
                                Value="34" />

						<Setter Property="Height"
                                Value="34" />

						<Setter Property="Background"
                                Value="#F8FAFC" />

						<Setter Property="BorderBrush"
                                Value="#CBD5E1" />

						<Setter Property="BorderThickness"
                                Value="1" />

						<Setter Property="Cursor"
                                Value="Hand" />

						<Setter Property="Template">

							<Setter.Value>

								<ControlTemplate TargetType="Button">

									<Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8">

										<ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />

									</Border>

									<ControlTemplate.Triggers>

										<Trigger Property="IsMouseOver"
                                                 Value="True">

											<Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="#EFF6FF" />

											<Setter TargetName="Bd"
                                                    Property="BorderBrush"
                                                    Value="#93C5FD" />

										</Trigger>

										<Trigger Property="IsPressed"
                                                 Value="True">

											<Setter TargetName="Bd"
                                                    Property="Opacity"
                                                    Value="0.8" />

										</Trigger>

									</ControlTemplate.Triggers>

								</ControlTemplate>

							</Setter.Value>

						</Setter>

					</Style>

				</Grid.Resources>

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<!-- ENCABEZADO -->

				<Grid Grid.Row="0"
                      Margin="6">

					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0"
                                VerticalAlignment="Center">

						<TextBlock Text="Evaluación: PREEXTRAORDINARIO"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#1B365D" />

						<TextBlock Text="Sólo se permiten calificaciones enteras de 0 a 6."
                                   FontSize="11"
                                   Foreground="#64748B"
                                   Margin="0,3,0,0" />

					</StackPanel>

					<TextBlock Grid.Column="1"
                               Text="PR = PRE REPROBADO   •   PA = PRE APROBADO"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#64748B"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0" />

				</Grid>

				<!-- ENCABEZADOS -->

				<Grid Grid.Row="1"
                      Margin="12,10,12,0">

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="80" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="70" />
						<ColumnDefinition Width="70" />
						<ColumnDefinition Width="70" />
						<ColumnDefinition Width="80" />
						<ColumnDefinition Width="170" />
					</Grid.ColumnDefinitions>

					<TextBlock Grid.Column="0"
                               Text="Matrícula"
                               FontWeight="Bold"
                               Foreground="#1B365D"
                               FontSize="13"
                               VerticalAlignment="Center" />

					<TextBlock Grid.Column="1"
                               Text="Nombre del Alumno"
                               FontWeight="Bold"
                               Foreground="#1B365D"
                               FontSize="13"
                               VerticalAlignment="Center" />

					<TextBlock Grid.Column="2"
                               Text="Parcial 1"
                               FontWeight="Bold"
                               Foreground="#1B365D"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

					<TextBlock Grid.Column="3"
                               Text="Parcial 2"
                               FontWeight="Bold"
                               Foreground="#1B365D"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

					<TextBlock Grid.Column="4"
                               Text="Parcial 3"
                               FontWeight="Bold"
                               Foreground="#1B365D"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

					<TextBlock Grid.Column="5"
                               Text="Promedio"
                               FontWeight="Bold"
                               Foreground="#1B365D"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

					<TextBlock Grid.Column="6"
                               Text="PREEXTRAORDINARIO"
                               FontWeight="Bold"
                               Foreground="#1B365D"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />

				</Grid>

				<!-- ALUMNOS -->

				<ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="6">

					<ItemsControl ItemsSource="{Binding AlumnosPre}">

						<ItemsControl.ItemTemplate>

							<DataTemplate>

								<Border Background="#FAFBFD"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="6"
                                        Margin="0,4">

									<Grid>

										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="80" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="70" />
											<ColumnDefinition Width="70" />
											<ColumnDefinition Width="70" />
											<ColumnDefinition Width="80" />
											<ColumnDefinition Width="170" />
										</Grid.ColumnDefinitions>

										<!-- MATRÍCULA -->

										<TextBlock Grid.Column="0"
                                                   Text="{Binding Matricula}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1E293B"
                                                   FontSize="14"
                                                   VerticalAlignment="Center" />

										<!-- NOMBRE -->

										<TextBlock Grid.Column="1"
                                                   Text="{Binding Nombre}"
                                                   Foreground="#334155"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />

										<!-- P1 -->

										<TextBlock Grid.Column="2"
                                                   Text="{Binding P1}"
                                                   Foreground="{Binding P1Foreground}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   FontSize="16" />

										<!-- P2 -->

										<TextBlock Grid.Column="3"
                                                   Text="{Binding P2}"
                                                   Foreground="{Binding P2Foreground}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   FontSize="16" />

										<!-- P3 -->

										<TextBlock Grid.Column="4"
                                                   Text="{Binding P3}"
                                                   Foreground="{Binding P3Foreground}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   FontSize="16" />

										<!-- PROMEDIO -->

										<TextBlock Grid.Column="5"
                                                   Text="{Binding Promedio}"
                                                   Foreground="{Binding PromedioForeground}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   FontSize="18" />

										<!-- PRE -->

										<Grid Grid.Column="6"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">

											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="Auto" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>

											<Button Grid.Column="0"
                                                    Style="{StaticResource InfoButtonStyle}"
                                                    Margin="0,0,12,0"
                                                    ToolTip="Ver información del alumno"
                                                    Click="InfoAlumnoButton_Click">

												<Viewbox Width="16"
                                                         Height="16">

													<Path Fill="#475569"
                                                          Data="M12,2A10,10 0 1,0 22,12A10,10 0 0,0 12,2ZM13,17H11V11H13V17ZM13,9H11V7H13V9Z" />

												</Viewbox>

											</Button>

											<StackPanel Grid.Column="1"
                                                        HorizontalAlignment="Center">

												<Border Style="{StaticResource PreGradeBlock}">

													<TextBox Width="100"
                                                             Height="44"
                                                             Text="{Binding Pre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Foreground="{Binding PreForeground}"
                                                             Style="{StaticResource RoundedTextBoxStyle}"
                                                             FontSize="22"
                                                             FontWeight="Black"
                                                             HorizontalContentAlignment="Center"
                                                             VerticalContentAlignment="Center"
                                                             MaxLength="2"
                                                             ToolTip="Calificación PRE de 0 a 6"
                                                             PreviewTextInput="PreTextBox_PreviewTextInput"
                                                             PreviewKeyDown="PreTextBox_PreviewKeyDown"
                                                             LostFocus="PreTextBox_LostFocus"
                                                             DataObject.Pasting="PreTextBox_Pasting" />

												</Border>

												<TextBlock Text="{Binding Estado}"
                                                           HorizontalAlignment="Center"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding EstadoForeground}"
                                                           Margin="0,4,0,0" />

											</StackPanel>

										</Grid>

									</Grid>

								</Border>

							</DataTemplate>

						</ItemsControl.ItemTemplate>

					</ItemsControl>

				</ScrollViewer>

			</Grid>

		</Border>

	</Grid>

</UserControl>