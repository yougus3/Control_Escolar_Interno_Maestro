        <!-- ========================================================= -->
        <!-- PALETA                                                     -->
        <!-- ========================================================= -->

        <SolidColorBrush x:Key="AppBlue"
                         Color="#1B365D" />

        <SolidColorBrush x:Key="AppBlueDark"
                         Color="#172F52" />

        <SolidColorBrush x:Key="AppBlueSoft"
                         Color="#EFF6FF" />

        <SolidColorBrush x:Key="AppBlueSoftBorder"
                         Color="#BFDBFE" />

        <SolidColorBrush x:Key="AppBorder"
                         Color="#D7DEE8" />

        <SolidColorBrush x:Key="AppBackground"
                         Color="#F1F5F9" />

        <SolidColorBrush x:Key="AppSurface"
                         Color="White" />

        <SolidColorBrush x:Key="AppSurfaceSoft"
                         Color="#F8FAFC" />

        <SolidColorBrush x:Key="AppTextPrimary"
                         Color="#0F172A" />

        <SolidColorBrush x:Key="AppTextSecondary"
                         Color="#64748B" />

        <SolidColorBrush x:Key="AppRed"
                         Color="#DC2626" />

        <SolidColorBrush x:Key="AppRedSoft"
                         Color="#FEF2F2" />

        <SolidColorBrush x:Key="AppGray"
                         Color="#6B7280" />

        <SolidColorBrush x:Key="AppGraySoft"
                         Color="#F3F4F6" />

        <!-- ========================================================= -->
        <!-- BOTÓN AZUL                                                 -->
        <!-- ========================================================= -->

        <Style x:Key="BlueButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="{StaticResource AppBlue}" />

            <Setter Property="Foreground"
                    Value="White" />

            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="Padding"
                    Value="12,6" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger
                                    Property="IsMouseOver"
                                    Value="True">

                                <Setter
                                        TargetName="Bd"
                                        Property="Background"
                                        Value="{StaticResource AppBlueDark}" />

                            </Trigger>

                            <Trigger
                                    Property="IsPressed"
                                    Value="True">

                                <Setter
                                        TargetName="Bd"
                                        Property="Opacity"
                                        Value="0.85" />

                            </Trigger>

                            <Trigger
                                    Property="IsEnabled"
                                    Value="False">

                                <Setter
                                        TargetName="Bd"
                                        Property="Opacity"
                                        Value="0.55" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ========================================================= -->
        <!-- BOTÓN BLANCO                                              -->
        <!-- ========================================================= -->

        <Style x:Key="WhiteButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="White" />

            <Setter Property="Foreground"
                    Value="{StaticResource AppBlue}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="BorderBrush"
                    Value="#CBD5E1" />

            <Setter Property="Padding"
                    Value="12,6" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger
                                    Property="IsMouseOver"
                                    Value="True">

                                <Setter
                                        TargetName="Bd"
                                        Property="Background"
                                        Value="{StaticResource AppBlueSoft}" />

                                <Setter
                                        TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="#94A3B8" />

                            </Trigger>

                            <Trigger
                                    Property="IsPressed"
                                    Value="True">

                                <Setter
                                        TargetName="Bd"
                                        Property="Opacity"
                                        Value="0.85" />

                            </Trigger>

                            <Trigger
                                    Property="IsEnabled"
                                    Value="False">

                                <Setter
                                        TargetName="Bd"
                                        Property="Opacity"
                                        Value="0.55" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ========================================================= -->
        <!-- BOTÓN PORCENTAJES                                         -->
        <!-- ========================================================= -->

        <Style x:Key="PercentageButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="White" />

            <Setter Property="BorderBrush"
                    Value="#CBD5E1" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Width"
                    Value="30" />

            <Setter Property="Height"
                    Value="30" />

            <Setter Property="Padding"
                    Value="0" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Focusable"
                    Value="False" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                                x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger
                                    Property="IsMouseOver"
                                    Value="True">

                                <Setter
                                        TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource AppRedSoft}" />

                                <Setter
                                        TargetName="Root"
                                        Property="BorderBrush"
                                        Value="#FCA5A5" />

                            </Trigger>

                            <Trigger
                                    Property="IsPressed"
                                    Value="True">

                                <Setter
                                        TargetName="Root"
                                        Property="Opacity"
                                        Value="0.8" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ========================================================= -->
        <!-- TEXTBOX REDONDEADO                                        -->
        <!-- ========================================================= -->

        <Style x:Key="RoundedTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Background"
                    Value="White" />

            <Setter Property="BorderBrush"
                    Value="#CBD5E1" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Padding"
                    Value="8,2" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ScrollViewer
                                    x:Name="PART_ContentHost" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger
                                    Property="IsKeyboardFocused"
                                    Value="True">

                                <Setter
                                        TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="{StaticResource AppBlue}" />

                            </Trigger>

                            <Trigger
                                    Property="IsMouseOver"
                                    Value="True">

                                <Setter
                                        TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="#93C5FD" />

                            </Trigger>

                            <Trigger
                                    Property="IsEnabled"
                                    Value="False">

                                <Setter
                                        TargetName="Bd"
                                        Property="Background"
                                        Value="{StaticResource AppGraySoft}" />

                                <Setter
                                        TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="#CBD5E1" />

                                <Setter
                                        Property="Foreground"
                                        Value="#94A3B8" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ========================================================= -->
        <!-- COMBOBOX REDONDEADO                                       -->
        <!-- ========================================================= -->

        <Style x:Key="RoundedComboStyle"
               TargetType="ComboBox">

            <Setter Property="Background"
                    Value="White" />

            <Setter Property="BorderBrush"
                    Value="#CBD5E1" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Padding"
                    Value="8,2" />

            <Setter Property="Foreground"
                    Value="#0F172A" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />

            <Setter Property="ItemContainerStyle">

                <Setter.Value>

                    <Style TargetType="ComboBoxItem">

                        <Setter Property="Padding"
                                Value="8,6" />

                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch" />

                        <Setter Property="Background"
                                Value="White" />

                        <Style.Triggers>

                            <Trigger
                                    Property="IsHighlighted"
                                    Value="True">

                                <Setter
                                        Property="Background"
                                        Value="{StaticResource AppBlueSoft}" />

                            </Trigger>

                        </Style.Triggers>

                    </Style>

                </Setter.Value>

            </Setter>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid
                                SnapsToDevicePixels="True">

                            <Border
                                    x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="30" />

                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter
                                            Margin="8,2,0,2"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                            IsHitTestVisible="False" />

                                    <ToggleButton
                                            Grid.Column="1"
                                            Focusable="False"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ClickMode="Press"
                                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">

                                        <Path
                                                Data="M 0 0 L 4 4 L 8 0 Z"
                                                Fill="#475569"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />

                                    </ToggleButton>

                                </Grid>

                            </Border>

                            <Popup
                                    x:Name="Popup"
                                    Placement="Bottom"
                                    AllowsTransparency="True"
                                    Focusable="False"
                                    PopupAnimation="Fade"
                                    IsOpen="{TemplateBinding IsDropDownOpen}"
                                    PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">

                                <Border
                                        Background="White"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">

                                    <ScrollViewer
                                            SnapsToDevicePixels="True">

                                        <ItemsPresenter />

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger
                                    Property="IsKeyboardFocused"
                                    Value="True">

                                <Setter
                                        TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="{StaticResource AppBlue}" />

                            </Trigger>

                            <Trigger
                                    Property="IsMouseOver"
                                    Value="True">

                                <Setter
                                        TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="#93C5FD" />

                            </Trigger>

                            <Trigger
                                    Property="IsEnabled"
                                    Value="False">

                                <Setter
                                        TargetName="Bd"
                                        Property="Background"
                                        Value="{StaticResource AppGraySoft}" />

                                <Setter
                                        TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="#CBD5E1" />

                                <Setter
                                        Property="Foreground"
                                        Value="#94A3B8" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="56" />

            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- BARRA DE HERRAMIENTAS                                    -->
        <!-- ========================================================= -->

        <Border
                Grid.Row="0"
                Background="{StaticResource AppBlue}"
                BorderBrush="#172F52"
                BorderThickness="1"
                CornerRadius="10"
                Margin="8,6,8,4">

            <Grid Margin="10,6">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto" />

                    <ColumnDefinition Width="500" />

                    <ColumnDefinition Width="Auto" />

                    <!-- CONTENEDOR DE EVAL + % -->
                    <ColumnDefinition Width="215" />

                    <ColumnDefinition Width="Auto" />

                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>

                <!-- ================================================= -->
                <!-- ARCHIVO                                            -->
                <!-- ================================================= -->

                <TextBlock
                        Grid.Column="0"
                        Text="Archivo"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Margin="0,0,6,0" />

                <ComboBox
                        Grid.Column="1"
                        Style="{StaticResource RoundedComboStyle}"
                        ItemsSource="{Binding ArchivosDisponibles}"
                        SelectedItem="{Binding ArchivoSeleccionado}"
                        Height="30"
                        Width="500"
                        MaxWidth="600"
                        VerticalContentAlignment="Center" />

                <!-- ================================================= -->
                <!-- EVALUACIÓN                                         -->
                <!-- ================================================= -->

                <TextBlock
                        Grid.Column="2"
                        Text="Eval."
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Margin="15,0,6,0" />

                <!-- ================================================= -->
                <!-- TEXTBOX + BOTÓN %                                 -->
                <!-- ================================================= -->

                <Grid
                        Grid.Column="3"
                        VerticalAlignment="Center">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="30" />

                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        Style="{StaticResource RoundedTextBoxStyle}"
                        Text="{Binding NombreEvaluacionSeleccionada, Mode=OneWay}"
                        Height="30"
                        Margin="0,0,6,0"
                        IsReadOnly="True"
                        VerticalContentAlignment="Center" />
                    
                    <Button
                            Grid.Column="1"
                            Style="{StaticResource PercentageButtonStyle}"
                            ToolTip="Ver resumen de porcentajes"
                            Click="Porcentajes_Click">

                        <Viewbox
                                Width="17"
                                Height="17">

                            <Path
                                    Data="{StaticResource PercentageGeometry}"
                                    Stroke="{StaticResource AppBlue}"
                                    StrokeThickness="2.2"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    Fill="Transparent"
                                    Stretch="Uniform" />

                        </Viewbox>

                    </Button>

                </Grid>

                <!-- ================================================= -->
                <!-- BOTÓN GUARDAR                                      -->
                <!-- ================================================= -->

                <Button
                        Grid.Column="4"
                        Command="{Binding GuardarCommand}"
                        Style="{StaticResource WhiteButtonStyle}"
                        Height="30"
                        Padding="20,0"
                        MinWidth="140"
                        Margin="15,0,12,0"
                        ToolTip="Guardar calificaciones en el archivo JSON local"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">

                    <StackPanel
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                        <TextBlock
                                Text="💾"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0"
                                FontSize="14" />

                        <TextBlock
                                Text="Guardar cambios"
                                VerticalAlignment="Center"
                                FontSize="13" />

                    </StackPanel>

                </Button>

                <!-- ================================================= -->
                <!-- BOTÓN CONFIGURACIÓN                                -->
                <!-- ================================================= -->

                <Button
                    Grid.Column="5"
                    Style="{StaticResource WhiteButtonStyle}"
                    Height="30"
                    Width="36"
                    Padding="0"
                    Margin="0,0,4,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    ToolTip="Configuración"
                    Click="Configuracion_Click">

                    <Viewbox
                        Width="17"
                        Height="17">

                        <Path
                            Data="{StaticResource SettingsGeometry}"
                            Fill="{StaticResource AppBlue}"
                            Stretch="Uniform" />

                    </Viewbox>

                </Button>
            </Grid>

        </Border>

        <!-- ========================================================= -->
        <!-- CONTENIDO PRINCIPAL                                       -->
        <!-- ========================================================= -->

        <ContentControl
                Grid.Row="1"
                Margin="8,4,8,8"
                Content="{Binding}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">

            <ContentControl.Style>

                <Style TargetType="ContentControl">

                    <Setter Property="ContentTemplate">

                        <Setter.Value>

                            <DataTemplate>

                                <views:ParcialesView
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" />

                            </DataTemplate>

                        </Setter.Value>

                    </Setter>

                    <Style.Triggers>

                        <DataTrigger
                                Binding="{Binding CurrentView}"
                                Value="Extra">

                            <Setter Property="ContentTemplate">

                                <Setter.Value>

                                    <DataTemplate>

                                        <views:ExtraView
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch" />

                                    </DataTemplate>

                                </Setter.Value>

                            </Setter>

                        </DataTrigger>

                        <DataTrigger
                                Binding="{Binding CurrentView}"
                                Value="Semestral">

                            <Setter Property="ContentTemplate">

                                <Setter.Value>

                                    <DataTemplate>

                                        <views:SemestralView
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch" />

                                    </DataTemplate>

                                </Setter.Value>

                            </Setter>

                        </DataTrigger>

                        <DataTrigger
                                Binding="{Binding CurrentView}"
                                Value="Preextraordinario">

                            <Setter Property="ContentTemplate">

                                <Setter.Value>

                                    <DataTemplate>

                                        <views:PreextraordinarioView
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch" />

                                    </DataTemplate>

                                </Setter.Value>

                            </Setter>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </ContentControl.Style>

        </ContentControl>

    </Grid>

</Window>