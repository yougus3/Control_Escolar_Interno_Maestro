<Window x:Class="Registro_de_Calificaciones_Jose_Ma._Morelos_y_Pavon.Views.ConfiguracionParcialesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Registro_de_Calificaciones_Jose_Ma._Morelos_y_Pavon.Converters"
        Title="Configuración"
        Width="980"
        Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F1F5F9">

    <Window.Resources>

        <SolidColorBrush x:Key="AppBlue"
                         Color="#1B365D" />

        <SolidColorBrush x:Key="AppBlueDark"
                         Color="#172F52" />

        <SolidColorBrush x:Key="AppBlueSoft"
                         Color="#EFF6FF" />

        <SolidColorBrush x:Key="AppBlueSoftBorder"
                         Color="#BFDBFE" />

        <SolidColorBrush x:Key="AppBorder"
                         Color="#D7DEE8" />

        <SolidColorBrush x:Key="AppSurface"
                         Color="White" />

        <SolidColorBrush x:Key="AppSurfaceSoft"
                         Color="#F8FAFC" />

        <SolidColorBrush x:Key="AppTextPrimary"
                         Color="#0F172A" />

        <SolidColorBrush x:Key="AppTextSecondary"
                         Color="#64748B" />


        <!-- ====================================================== -->
        <!-- CARD -->
        <!-- ====================================================== -->

        <Style x:Key="CardBorderStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White" />

            <Setter Property="BorderBrush"
                    Value="#D7DEE8" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="CornerRadius"
                    Value="12" />

        </Style>


        <!-- ====================================================== -->
        <!-- BOTÓN PRINCIPAL -->
        <!-- ====================================================== -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="{StaticResource AppBlue}" />

            <Setter Property="Foreground"
                    Value="White" />

            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Padding"
                    Value="12,6" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{StaticResource AppBlueDark}" />

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="Bd"
                                        Property="Opacity"
                                        Value="0.85" />

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="Bd"
                                        Property="Opacity"
                                        Value="0.55" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ====================================================== -->
        <!-- BOTÓN VERDE -->
        <!-- ====================================================== -->

        <Style x:Key="SuccessButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">

            <Setter Property="Background"
                    Value="#16A34A" />

        </Style>


        <!-- ====================================================== -->
        <!-- BOTÓN SECUNDARIO -->
        <!-- ====================================================== -->

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#E2E8F0" />

            <Setter Property="Foreground"
                    Value="#0F172A" />

            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Padding"
                    Value="12,6" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#CBD5E1" />

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="Bd"
                                        Property="Opacity"
                                        Value="0.85" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ====================================================== -->
        <!-- TEXTBOX -->
        <!-- ====================================================== -->

        <Style x:Key="RoundedTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Background"
                    Value="White" />

            <Setter Property="BorderBrush"
                    Value="#CBD5E1" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Padding"
                    Value="8,2" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">

                            <ScrollViewer x:Name="PART_ContentHost" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="{StaticResource AppBlue}" />

                                <Setter TargetName="Bd"
                                        Property="BorderThickness"
                                        Value="1.5" />

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="#93C5FD" />

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#F3F4F6" />

                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="#CBD5E1" />

                                <Setter Property="Foreground"
                                        Value="#94A3B8" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ====================================================== -->
        <!-- COMBOBOX -->
        <!-- ====================================================== -->

        <Style x:Key="RoundedComboStyle"
               TargetType="ComboBox">

            <Setter Property="Background"
                    Value="White" />

            <Setter Property="BorderBrush"
                    Value="#CBD5E1" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Foreground"
                    Value="#0F172A" />

            <Setter Property="Padding"
                    Value="8,2" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />

            <Setter Property="ItemContainerStyle">

                <Setter.Value>

                    <Style TargetType="ComboBoxItem">

                        <Setter Property="Padding"
                                Value="8,6" />

                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch" />

                        <Setter Property="Background"
                                Value="White" />

                        <Style.Triggers>

                            <Trigger Property="IsHighlighted"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#EFF6FF" />

                            </Trigger>

                        </Style.Triggers>

                    </Style>

                </Setter.Value>

            </Setter>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid SnapsToDevicePixels="True">

                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="30" />

                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter
                                        Margin="8,2,0,2"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                        IsHitTestVisible="False" />

                                    <ToggleButton Grid.Column="1"
                                                  Focusable="False"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen,
                                                                      RelativeSource={RelativeSource TemplatedParent},
                                                                      Mode=TwoWay}">

                                        <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="#475569"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />

                                    </ToggleButton>

                                </Grid>

                            </Border>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">

                                <Border Background="White"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth,
                                                            RelativeSource={RelativeSource TemplatedParent}}">

                                    <ScrollViewer
                                        SnapsToDevicePixels="True">

                                        <ItemsPresenter />

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="{StaticResource AppBlue}" />

                                <Setter TargetName="Bd"
                                        Property="BorderThickness"
                                        Value="1.5" />

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="#93C5FD" />

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#F3F4F6" />

                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="#CBD5E1" />

                                <Setter Property="Foreground"
                                        Value="#94A3B8" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ====================================================== -->
        <!-- GROUPBOX -->
        <!-- ====================================================== -->

        <Style TargetType="GroupBox">

            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="Padding"
                    Value="0" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="GroupBox">

                        <Border Background="White"
                                BorderBrush="#D7DEE8"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12">

                            <DockPanel>

                                <TextBlock
                                    DockPanel.Dock="Top"
                                    Text="{TemplateBinding Header}"
                                    FontWeight="Bold"
                                    FontSize="14"
                                    Foreground="#1B365D"
                                    Margin="0,0,0,10" />

                                <ContentPresenter />

                            </DockPanel>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ====================================================== -->
        <!-- TABCONTROL -->
        <!-- ====================================================== -->

        <Style TargetType="TabControl">

            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="Padding"
                    Value="0" />

        </Style>


        <!-- ====================================================== -->
        <!-- TABITEM -->
        <!-- ====================================================== -->

        <Style TargetType="TabItem">

            <Setter Property="Background"
                    Value="#E2E8F0" />

            <Setter Property="Foreground"
                    Value="#334155" />

            <Setter Property="BorderBrush"
                    Value="#CBD5E1" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Padding"
                    Value="14,8" />

            <Setter Property="Margin"
                    Value="0,0,6,0" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TabItem">

                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10,10,0,0"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ContentSource="Header" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="White" />

                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="#D7DEE8" />

                                <Setter Property="Foreground"
                                        Value="{StaticResource AppBlue}" />

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#F8FAFC" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <converters:BooleanToVisibilityConverter
            x:Key="BoolToVisibility" />

    </Window.Resources>


    <!-- ========================================================== -->
    <!-- CONTENEDOR PRINCIPAL -->
    <!-- ========================================================== -->

    <Grid Margin="16">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>


        <!-- ====================================================== -->
        <!-- TÍTULO -->
        <!-- ====================================================== -->

        <TextBlock Text="Configuración"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#1B365D"
                   Margin="2,0,0,12" />


        <!-- ====================================================== -->
        <!-- CONTENIDO -->
        <!-- ====================================================== -->

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D7DEE8"
                BorderThickness="1"
                CornerRadius="12">

            <TabControl Background="Transparent"
                        BorderThickness="0"
                        Padding="0">

                <!-- ================================================== -->
                <!-- PARCIALES -->
                <!-- ================================================== -->

                <TabItem Header="Parciales">

                    <Grid Margin="16">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="*" />

                            <RowDefinition Height="Auto" />

                        </Grid.RowDefinitions>


                        <StackPanel>

                            <TextBlock
                                Text="Selecciona la evaluación a capturar:"
                                Foreground="#475569"
                                FontSize="13"
                                Margin="0,0,0,12" />

                            <StackPanel Margin="0,0,0,14">

                                <ComboBox
                                    Width="200"
                                    Height="32"
                                    HorizontalAlignment="Left"
                                    ItemsSource="{Binding EvaluacionesGlobalesDisponibles}"
                                    SelectedItem="{Binding EvaluacionGlobalSeleccionada,
                                                           Mode=TwoWay}"
                                    IsEnabled="{Binding IsGlobalComboEnabled}"
                                    VerticalContentAlignment="Center"
                                    Style="{StaticResource RoundedComboStyle}" />

                                <TextBlock
                                    Text="⚠️ Esta configuración aplica a todas las materias simultáneamente."
                                    Foreground="#EF4444"
                                    FontSize="11"
                                    Margin="0,8,0,0" />

                                <TextBlock
                                    Text="Este archivo CAP es de evaluación EXTRA. No se pueden configurar parciales aquí."
                                    Foreground="#DC2626"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding MensajeExtraVisible,
                                                         Converter={StaticResource BoolToVisibility}}" />

                            </StackPanel>

                        </StackPanel>


                        <Border
                            Grid.Row="2"
                            Background="#F8FAFC"
                            BorderBrush="#D7DEE8"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12"
                            Margin="0,16,0,16">

                            <StackPanel>

                                <TextBlock
                                    Text="Los cambios se guardan y aplican globalmente de forma automática."
                                    Foreground="#64748B"
                                    FontSize="12" />

                            </StackPanel>

                        </Border>

                    </Grid>

                </TabItem>


                <!-- ================================================== -->
                <!-- EXPORTACIÓN -->
                <!-- ================================================== -->

                <TabItem Header="Exportación">

                    <Grid Margin="16">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="*" />

                            <RowDefinition Height="Auto" />

                        </Grid.RowDefinitions>


                        <!-- TÍTULO -->

                        <TextBlock
                            Text="Exportar calificaciones"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#1B365D"
                            Margin="0,0,0,6" />


                        <!-- DESCRIPCIÓN -->

                        <TextBlock
                            Grid.Row="1"
                            Text="Genera el reporte de calificaciones en formato PDF."
                            Foreground="#64748B"
                            FontSize="13"
                            Margin="0,0,0,18" />


                        <!-- PANEL -->

                        <Border
                            Grid.Row="2"
                            Background="#F8FAFC"
                            BorderBrush="#D7DEE8"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="*" />

                                </Grid.RowDefinitions>


                                <TextBlock
                                    Text="Reporte de calificaciones"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="#1B365D"
                                    Margin="0,0,0,8" />


                                <TextBlock
                                    Grid.Row="1"
                                    Text="El reporte se generará utilizando el formato institucional configurado para el sistema."
                                    Foreground="#64748B"
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    MaxWidth="700" />


                                <StackPanel
                                    Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Margin="0,24,0,0">

                                    <Button
                                        Content="Exportar PDF"
                                        Width="150"
                                        Height="38"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="ExportarPdf_Click" />

                                </StackPanel>

                            </Grid>

                        </Border>


                        <!-- INFORMACIÓN -->

                        <Border
                            Grid.Row="3"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,16,0,0">

                            <TextBlock
                                Text="El archivo PDF se guardará en la ubicación que selecciones."
                                Foreground="#1E40AF"
                                FontSize="12" />

                        </Border>

                    </Grid>

                </TabItem>

            </TabControl>

        </Border>


        <!-- ====================================================== -->
        <!-- CERRAR -->
        <!-- ====================================================== -->

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,12,0,0">

            <Button
                Content="Cerrar"
                Width="100"
                Height="34"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="Cerrar_Click" />

        </StackPanel>

    </Grid>

</Window>