<Window x:Class="Registro_de_Calificaciones_Jose_Ma._Morelos_y_Pavon.Views.ConfiguracionParcialesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Registro_de_Calificaciones_Jose_Ma._Morelos_y_Pavon.Converters"
        Title="Configuración"
        Width="1180"
        Height="650"
        MinWidth="1080"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F1F5F9">

    <Window.Resources>

        <!-- ========================================================== -->
        <!-- COLORES -->
        <!-- ========================================================== -->

        <SolidColorBrush x:Key="AppBlue"
                         Color="#1B365D"/>

        <SolidColorBrush x:Key="AppBlueDark"
                         Color="#142A46"/>

        <SolidColorBrush x:Key="AppBlueHover"
                         Color="#244A7A"/>

        <SolidColorBrush x:Key="AppBlueSoft"
                         Color="#EFF6FF"/>

        <SolidColorBrush x:Key="AppBlueBorder"
                         Color="#BFDBFE"/>

        <SolidColorBrush x:Key="AppGreen"
                         Color="#16A34A"/>

        <SolidColorBrush x:Key="AppGreenHover"
                         Color="#15803D"/>

        <SolidColorBrush x:Key="AppBorder"
                         Color="#D7DEE8"/>

        <SolidColorBrush x:Key="AppBorderSoft"
                         Color="#E2E8F0"/>

        <SolidColorBrush x:Key="AppTextPrimary"
                         Color="#0F172A"/>

        <SolidColorBrush x:Key="AppTextSecondary"
                         Color="#64748B"/>

        <!-- ========================================================== -->
        <!-- CONVERTER -->
        <!-- ========================================================== -->

        <converters:BooleanToVisibilityConverter
            x:Key="BoolToVisibility"/>

        <!-- ========================================================== -->
        <!-- BOTÓN AZUL -->
        <!-- ========================================================== -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="{StaticResource AppBlue}"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource AppBlue}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                TextElement.FontWeight="{TemplateBinding FontWeight}"
                                TextElement.FontSize="{TemplateBinding FontSize}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{StaticResource AppBlueHover}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{StaticResource AppBlueDark}"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="Bd"
                                        Property="Opacity"
                                        Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ========================================================== -->
        <!-- BOTÓN VERDE -->
        <!-- ========================================================== -->

        <Style x:Key="SuccessButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">

            <Setter Property="Background"
                    Value="{StaticResource AppGreen}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource AppGreen}"/>

            <Setter Property="Padding"
                    Value="18,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                TextElement.FontWeight="{TemplateBinding FontWeight}"
                                TextElement.FontSize="{TemplateBinding FontSize}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{StaticResource AppGreenHover}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="Bd"
                                        Property="Opacity"
                                        Value="0.85"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="Bd"
                                        Property="Opacity"
                                        Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ========================================================== -->
        <!-- BOTÓN SECUNDARIO -->
        <!-- ========================================================== -->

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#E2E8F0"/>

            <Setter Property="Foreground"
                    Value="#1E293B"/>

            <Setter Property="BorderBrush"
                    Value="#CBD5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                TextElement.FontWeight="{TemplateBinding FontWeight}"
                                TextElement.FontSize="{TemplateBinding FontSize}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#CBD5E1"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="Bd"
                                        Property="Opacity"
                                        Value="0.8"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="Bd"
                                        Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ========================================================== -->
        <!-- TEXTBOX -->
        <!-- ========================================================== -->

        <Style x:Key="RoundedTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="{StaticResource AppTextPrimary}"/>

            <Setter Property="BorderBrush"
                    Value="#CBD5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="{StaticResource AppBlue}"/>

                                <Setter TargetName="Bd"
                                        Property="BorderThickness"
                                        Value="1.5"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="#93C5FD"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#F1F5F9"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ========================================================== -->
        <!-- COMBOBOX -->
        <!-- ========================================================== -->

        <Style x:Key="RoundedComboStyle"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="{StaticResource AppTextPrimary}"/>

            <Setter Property="BorderBrush"
                    Value="#CBD5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="ItemContainerStyle">

                <Setter.Value>

                    <Style TargetType="ComboBoxItem">

                        <Setter Property="Padding"
                                Value="10,8"/>

                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>

                        <Setter Property="Background"
                                Value="White"/>

                        <Setter Property="Foreground"
                                Value="#0F172A"/>

                        <Style.Triggers>

                            <Trigger Property="IsHighlighted"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#EFF6FF"/>

                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#DBEAFE"/>

                            </Trigger>

                        </Style.Triggers>

                    </Style>

                </Setter.Value>

            </Setter>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="34"/>

                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter
                                        Grid.Column="0"
                                        Margin="10,0,4,0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                        TextElement.Foreground="{TemplateBinding Foreground}"
                                        IsHitTestVisible="False"/>

                                    <ToggleButton
                                        Grid.Column="1"
                                        Focusable="False"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ClickMode="Press"
                                        IsChecked="{Binding IsDropDownOpen,
                                                            RelativeSource={RelativeSource TemplatedParent},
                                                            Mode=TwoWay}">

                                        <Path
                                            Data="M 0 0 L 5 5 L 10 0 Z"
                                            Fill="#475569"
                                            Width="10"
                                            Height="6"
                                            Stretch="Fill"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </ToggleButton>

                                </Grid>

                            </Border>

                            <Popup
                                x:Name="Popup"
                                Placement="Bottom"
                                AllowsTransparency="True"
                                Focusable="False"
                                PopupAnimation="Fade"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">

                                <Border
                                    Background="White"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,5,0,0"
                                    MinWidth="{Binding ActualWidth,
                                                        RelativeSource={RelativeSource TemplatedParent}}">

                                    <ScrollViewer
                                        MaxHeight="260"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled">

                                        <ItemsPresenter/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocusWithin"
                                     Value="True">

                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="{StaticResource AppBlue}"/>

                                <Setter TargetName="Bd"
                                        Property="BorderThickness"
                                        Value="1.5"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="#93C5FD"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#F1F5F9"/>

                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="#CBD5E1"/>

                                <Setter TargetName="Bd"
                                        Property="Opacity"
                                        Value="0.8"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ========================================================== -->
        <!-- CHECKBOX -->
        <!-- ========================================================== -->

        <Style x:Key="BigCheckBoxStyle"
               TargetType="CheckBox">

            <Setter Property="Foreground"
                    Value="#0F172A"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

        <!-- ========================================================== -->
        <!-- TABCONTROL -->
        <!-- ========================================================== -->

        <Style TargetType="TabControl">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="0"/>

        </Style>

        <!-- ========================================================== -->
        <!-- TABITEM -->
        <!-- ========================================================== -->

        <Style TargetType="TabItem">

            <Setter Property="Background"
                    Value="#E2E8F0"/>

            <Setter Property="Foreground"
                    Value="#475569"/>

            <Setter Property="BorderBrush"
                    Value="#CBD5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="18,9"/>

            <Setter Property="Margin"
                    Value="0,0,7,0"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TabItem">

                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9,9,0,0"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                TextElement.FontWeight="{TemplateBinding FontWeight}"
                                TextElement.FontSize="{TemplateBinding FontSize}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="White"/>

                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="#D7DEE8"/>

                                <Setter Property="Foreground"
                                        Value="{StaticResource AppBlue}"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#F8FAFC"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <!-- ========================================================== -->
    <!-- CONTENEDOR PRINCIPAL -->
    <!-- ========================================================== -->

    <Grid Margin="18">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <!-- ====================================================== -->
        <!-- ENCABEZADO -->
        <!-- ====================================================== -->

        <StackPanel
            Grid.Row="0"
            Margin="2,0,0,12">

            <TextBlock
                Text="Configuración"
                FontSize="21"
                FontWeight="Bold"
                Foreground="{StaticResource AppBlue}"/>

            <TextBlock
                Text="Configuración de evaluaciones y envío de calificaciones."
                FontSize="11"
                Foreground="{StaticResource AppTextSecondary}"
                Margin="0,3,0,0"/>

        </StackPanel>

        <!-- ====================================================== -->
        <!-- CONTENIDO -->
        <!-- ====================================================== -->

        <Border
            Grid.Row="1"
            Background="White"
            BorderBrush="{StaticResource AppBorder}"
            BorderThickness="1"
            CornerRadius="12">

            <TabControl>

                <!-- ================================================== -->
                <!-- PARCIALES -->
                <!-- ================================================== -->

                <TabItem Header="Parciales">

                    <ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">

                        <Grid Margin="22">

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>

                            <StackPanel
                                Grid.Row="0"
                                Margin="0,0,0,18">

                                <TextBlock
                                    Text="Evaluación global"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource AppBlue}"/>

                                <TextBlock
                                    Text="Selecciona el tipo de evaluación que deseas configurar."
                                    FontSize="11"
                                    Foreground="{StaticResource AppTextSecondary}"
                                    Margin="0,4,0,0"/>

                            </StackPanel>

                            <Border
                                Grid.Row="1"
                                Background="#F8FAFC"
                                BorderBrush="{StaticResource AppBorderSoft}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18"
                                Margin="0,0,0,16">

                                <StackPanel>

                                    <TextBlock
                                        Text="Evaluación a capturar"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="#334155"
                                        Margin="0,0,0,7"/>

                                    <ComboBox
                                        Width="230"
                                        Height="40"
                                        HorizontalAlignment="Left"
                                        ItemsSource="{Binding EvaluacionesGlobalesDisponibles}"
                                        SelectedItem="{Binding EvaluacionGlobalSeleccionada,
                                                                Mode=TwoWay}"
                                        IsEnabled="{Binding IsGlobalComboEnabled,
                                                            Mode=OneWay}"
                                        Style="{StaticResource RoundedComboStyle}"/>

                                    <Border
                                        Background="#FEF2F2"
                                        BorderBrush="#FECACA"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,14,0,0">

                                        <TextBlock
                                            Text="Esta configuración se aplica globalmente a todas las materias."
                                            FontSize="11"
                                            Foreground="#B91C1C"
                                            TextWrapping="Wrap"/>

                                    </Border>

                                    <Border
                                        Background="#FEF2F2"
                                        BorderBrush="#FECACA"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,10,0,0"
                                        Visibility="{Binding MensajeExtraVisible,
                                                             Mode=OneWay,
                                                             Converter={StaticResource BoolToVisibility}}">

                                        <TextBlock
                                            Text="Este archivo CAP corresponde a EVALUACIÓN EXTRA. No se pueden configurar parciales aquí."
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="#B91C1C"
                                            TextWrapping="Wrap"/>

                                    </Border>

                                </StackPanel>

                            </Border>

                            <Border
                                Grid.Row="2"
                                Background="#EFF6FF"
                                BorderBrush="{StaticResource AppBlueBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16">

                                <StackPanel>

                                    <TextBlock
                                        Text="Aplicación automática"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="#1E40AF"/>

                                    <TextBlock
                                        Text="Los cambios se guardan automáticamente y se aplican a las materias correspondientes."
                                        FontSize="11"
                                        Foreground="#475569"
                                        Margin="0,5,0,0"
                                        TextWrapping="Wrap"/>

                                </StackPanel>

                            </Border>

                        </Grid>

                    </ScrollViewer>

                </TabItem>

                <!-- ================================================== -->
                <!-- ENVÍO DE CALIFICACIONES -->
                <!-- ================================================== -->

                <TabItem Header="Envío de calificaciones">

                    <Grid Margin="20">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="390"/>

                            <ColumnDefinition Width="20"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <!-- ================================================= -->
                        <!-- CAPS -->
                        <!-- ================================================= -->

                        <Border
                            Grid.Column="0"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource AppBorderSoft}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12">

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition Height="*"/>

                                </Grid.RowDefinitions>

                                <!-- TÍTULO -->

                                <StackPanel
                                    Grid.Row="0"
                                    Margin="0,0,0,10">

                                    <TextBlock
                                        Text="CAPs del reporte"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource AppBlue}"/>

                                    <TextBlock
                                        Text="Elige las materias que deseas incluir."
                                        FontSize="10"
                                        Foreground="{StaticResource AppTextSecondary}"
                                        Margin="0,3,0,0"
                                        TextWrapping="Wrap"/>

                                </StackPanel>

                                <!-- BOTONES -->

                                <StackPanel
                                    Grid.Row="1"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,9">

                                    <Button
                                        Content="SELECCIONAR TODO"
                                        Width="185"
                                        Height="34"
                                        Margin="0,0,7,0"
                                        Click="SeleccionarTodoCaps_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"/>

                                    <Button
                                        Content="NINGUNO"
                                        Width="95"
                                        Height="34"
                                        Click="DeseleccionarTodoCaps_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"/>

                                </StackPanel>

                                <!-- ================================================= -->
                                <!-- ÚNICO SCROLL DE LA LISTA CAP -->
                                <!-- ================================================= -->

                                <Border
                                    Grid.Row="2"
                                    Background="White"
                                    BorderBrush="{StaticResource AppBorderSoft}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="7">

                                    <ScrollViewer
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled">

                                        <ItemsControl
                                            ItemsSource="{Binding CapFiles}">

                                            <ItemsControl.ItemTemplate>

                                                <DataTemplate>

                                                    <Border
                                                        Background="White"
                                                        BorderBrush="#E2E8F0"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Padding="10"
                                                        Margin="0,0,0,7">

                                                        <CheckBox
                                                            IsChecked="{Binding IsSelected,
                                                                                Mode=TwoWay}"
                                                            VerticalContentAlignment="Center">

                                                            <TextBlock
                                                                Text="{Binding DisplayName}"
                                                                FontSize="12.5"
                                                                FontWeight="SemiBold"
                                                                Foreground="#334155"
                                                                TextWrapping="Wrap"
                                                                LineHeight="18"
                                                                MaxWidth="340"/>

                                                        </CheckBox>

                                                    </Border>

                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </ScrollViewer>

                                </Border>

                            </Grid>

                        </Border>

                        <!-- ================================================= -->
                        <!-- PROFESOR / CORREO -->
                        <!-- ================================================= -->

                        <Border
                            Grid.Column="2"
                            Background="White"
                            BorderBrush="{StaticResource AppBorderSoft}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="15">

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition Height="*"/>

                                    <RowDefinition Height="Auto"/>

                                </Grid.RowDefinitions>

                                <!-- ============================================ -->
                                <!-- USAR PROFESOR DETECTADO -->
                                <!-- ============================================ -->

                                <Border
                                    Grid.Row="0"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,0,0,12">

                                    <CheckBox
                                        Content="Usar profesor detectado del CAP"
                                        IsChecked="{Binding UsarProfesorDelCap,
                                                            Mode=TwoWay}"
                                        Style="{StaticResource BigCheckBoxStyle}"
                                        Margin="0"/>

                                </Border>

                                <!-- ============================================ -->
                                <!-- PROFESOR + CLAVE -->
                                <!-- ============================================ -->

                                <Grid
                                    Grid.Row="1"
                                    Margin="0,0,0,12">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="18"/>

                                        <ColumnDefinition Width="190"/>

                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock
                                            Text="Profesor"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="#475569"
                                            Margin="0,0,0,5"/>

                                        <ComboBox
                                            ItemsSource="{Binding Profesores,
                                                                  Mode=OneWay}"
                                            SelectedItem="{Binding ProfesorSeleccionado,
                                                                   Mode=TwoWay}"
                                            DisplayMemberPath="TextoCombo"
                                            IsEnabled="{Binding ProfesorComboHabilitado,
                                                                Mode=OneWay}"
                                            Style="{StaticResource RoundedComboStyle}"/>

                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="2">

                                        <TextBlock
                                            Text="CLAVEPROFESOR"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="#475569"
                                            Margin="0,0,0,5"/>

                                        <TextBox
                                            Text="{Binding ClaveProfesorCap,
                                                          Mode=OneWay}"
                                            IsReadOnly="True"
                                            Background="#F8FAFC"
                                            Style="{StaticResource RoundedTextBoxStyle}"/>

                                    </StackPanel>

                                </Grid>

                                <!-- ============================================ -->
                                <!-- CORREO DEL PROFESOR -->
                                <!-- ============================================ -->

                                <StackPanel
                                    Grid.Row="2"
                                    Margin="0,0,0,12">

                                    <TextBlock
                                        Text="Correo del profesor"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="#475569"
                                        Margin="0,0,0,5"/>

                                    <!--
                                        ESTE DATO VIENE DE:
                                        configuracion.bin
                                        -> LiteDbService
                                        -> ProfesorConfigurado.EMAIL
                                    -->

                                    <TextBox
                                        Text="{Binding CorreoProfesorSeleccionado,
                                                      Mode=OneWay}"
                                        IsReadOnly="True"
                                        Background="#F8FAFC"
                                        Style="{StaticResource RoundedTextBoxStyle}"/>

                                </StackPanel>

                                <!-- ============================================ -->
                                <!-- CORREO ALTERNATIVO -->
                                <!-- ============================================ -->

                                <Border
                                    Grid.Row="3"
                                    VerticalAlignment="Top"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="11">

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto"/>

                                            <ColumnDefinition Width="18"/>

                                            <ColumnDefinition Width="*"/>

                                        </Grid.ColumnDefinitions>

                                        <CheckBox
                                            Content="Enviar a otro correo"
                                            IsChecked="{Binding EnviarAOtroCorreo,
                                                                Mode=TwoWay}"
                                            VerticalAlignment="Center"
                                            Foreground="#0F172A"
                                            FontSize="11.5"/>

                                        <TextBox
                                            Grid.Column="2"
                                            Text="{Binding CorreoAlternativo,
                                                           Mode=TwoWay,
                                                           UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding EnviarAOtroCorreo,
                                                                Mode=OneWay}"
                                            ToolTip="Correo alternativo"
                                            Style="{StaticResource RoundedTextBoxStyle}"/>

                                    </Grid>

                                </Border>

                                <!-- ============================================ -->
                                <!-- BOTONES -->
                                <!-- ============================================ -->

                                <StackPanel
                                    Grid.Row="4"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,14,0,0">

                                    <Button
                                        Content="EXPORTAR PDF"
                                        Width="160"
                                        Height="44"
                                        Margin="0,0,10,0"
                                        Click="ExportarPdf_Click"
                                        Style="{StaticResource PrimaryButtonStyle}"/>

                                    <Button
                                        Content="ENVIAR CALIFICACIONES"
                                        Width="230"
                                        Height="44"
                                        Click="EnviarCalificaciones_Click"
                                        IsEnabled="{Binding PuedeEnviarCorreo,
                                                            Mode=OneWay}"
                                        Style="{StaticResource SuccessButtonStyle}"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </Grid>

                </TabItem>

            </TabControl>

        </Border>

        <!-- ====================================================== -->
        <!-- CERRAR -->
        <!-- ====================================================== -->

        <Grid
            Grid.Row="2"
            Margin="0,10,0,0">

            <Button
                Content="CERRAR"
                Width="100"
                Height="34"
                HorizontalAlignment="Right"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="Cerrar_Click"/>

        </Grid>

    </Grid>

</Window>