<Window x:Class="Registro_de_Calificaciones_Jose_Ma._Morelos_y_Pavon.Views.Modals.PorcentajesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consulta de calificaciones"
        Width="1100"
        Height="740"
        MinWidth="1100"
        MinHeight="540"
        MaxWidth="1100"
        MaxHeight="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F1F5F9">

    <Window.Resources>

        <Style x:Key="IconButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Padding"
                    Value="8,6" />

            <Setter Property="MinHeight"
                    Value="40" />

            <Setter Property="MinWidth"
                    Value="40" />

            <Setter Property="Focusable"
                    Value="False" />

            <Setter Property="IsTabStop"
                    Value="False" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#EFF6FF" />

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.85" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Border Margin="16"
            Background="White"
            CornerRadius="14">

        <Grid Margin="18">

            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Consulta de calificaciones"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="#1B365D" />

                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0">

                        <TextBlock x:Name="TbAlumnoNombre"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#334155" />

                        <TextBlock Text="  •  "
                                   FontSize="13"
                                   Foreground="#94A3B8" />

                        <TextBlock x:Name="TbAlumnoMatricula"
                                   FontSize="13"
                                   Foreground="#64748B" />

                    </StackPanel>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock Text="EVALUACIÓN"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#64748B"
                               Margin="0,0,0,4" />

                    <ComboBox x:Name="CmbParcial"
                              Height="32"
                              Width="190"
                              HorizontalAlignment="Left"
                              FontSize="13"
                              Background="White"
                              BorderBrush="#CBD5E1"
                              BorderThickness="1" />

                </StackPanel>

                <!-- CALIFICACIÓN GENERAL -->
                <Border Grid.Column="2"
                        Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,5"
                        VerticalAlignment="Center">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="CALIFICACIÓN GENERAL"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#1B365D"
                                   TextWrapping="Wrap" />

                        <TextBlock x:Name="TbCalificacionGeneral"
                                   Grid.Column="1"
                                   Text="--"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#1B365D" />

                    </Grid>

                </Border>

            </Grid>

            <Border Grid.Row="1"
                    Background="#E2E8F0" />

            <!-- CONTENIDO -->
            <Grid Grid.Row="2"
                  Margin="0,12,0,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ALUMNOS -->
                <Border Grid.Column="0"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10">

                    <Grid Margin="10">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="ALUMNOS"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#64748B"
                                   VerticalAlignment="Center" />

                        <ListBox x:Name="LstAlumnos"
                                 Grid.Row="1"
                                 BorderThickness="0"
                                 Background="Transparent">

                            <ListBox.ItemContainerStyle>

                                <Style TargetType="ListBoxItem">

                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Stretch" />

                                    <Setter Property="Padding"
                                            Value="0" />

                                    <Setter Property="Margin"
                                            Value="0,1" />

                                </Style>

                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>

                                <DataTemplate>

                                    <Border Background="Transparent"
                                            Padding="5,3"
                                            Margin="1,0">

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="40" />

                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Text="{Binding Matricula}"
                                                FontWeight="SemiBold"
                                                Foreground="#1E293B"
                                                FontSize="13"
                                                VerticalAlignment="Center" />

                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding Nombre}"
                                                Foreground="#334155"
                                                FontSize="13"
                                                VerticalAlignment="Center"
                                                TextTrimming="CharacterEllipsis" />

                                            <!-- INFORMACIÓN DEL ALUMNO -->

                                            <Button
                                                Grid.Column="2"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTip="Ver detalles del alumno"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Click="PapelButton_Click"
                                                Tag="{Binding}"
                                                Focusable="False"
                                                IsTabStop="False"
                                                Padding="4,2"
                                                MinWidth="32"
                                                MinHeight="30">

                                                <Viewbox
                                                    Width="19"
                                                    Height="19">

                                                    <Path
                                                        Fill="#1B365D"
                                                        Data="M12,2A10,10 0 1,0 22,12A10,10 0 0,0 12,2ZM13,17H11V11H13V17ZM13,9H11V7H13V9Z" />

                                                </Viewbox>

                                            </Button>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ListBox.ItemTemplate>

                        </ListBox>

                    </Grid>

                </Border>

                <!-- DETALLE -->
                <Border Grid.Column="2"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="36" />
                        </Grid.RowDefinitions>

                        <!-- CABECERAS -->
                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="ACTIVIDAD"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#64748B" />

                            <TextBlock Grid.Column="1"
                                       Text="NOMBRE"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#64748B" />

                            <TextBlock Grid.Column="2"
                                       Text="%"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#64748B" />

                            <TextBlock Grid.Column="3"
                                       Text="MÁX."
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#64748B" />

                            <TextBlock Grid.Column="4"
                                       Text="OBTENIDO"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#64748B" />

                        </Grid>

                        <!-- ACTIVIDADES -->
                        <Grid Grid.Row="1">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 1 -->
                            <Border Grid.Row="0"
                                    Margin="0,2"
                                    Background="White"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="8">

                                <Grid Margin="9,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="ACTIVIDAD 1"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#1B365D"
                                               VerticalAlignment="Center" />

                                    <TextBlock x:Name="TbActividad1Nombre"
                                               Grid.Column="1"
                                               FontSize="12"
                                               Foreground="#334155"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />

                                    <TextBlock x:Name="TbActividad1Porcentaje"
                                               Grid.Column="2"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#1B365D" />

                                    <TextBlock x:Name="TbActividad1Maximo"
                                               Grid.Column="3"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#64748B" />

                                    <TextBlock x:Name="TbActividad1Calificacion"
                                               Grid.Column="4"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="#1B365D" />

                                </Grid>

                            </Border>

                            <!-- 2 -->
                            <Border Grid.Row="1"
                                    Margin="0,2"
                                    Background="White"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="8">

                                <Grid Margin="9,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="ACTIVIDAD 2"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#1B365D"
                                               VerticalAlignment="Center" />

                                    <TextBlock x:Name="TbActividad2Nombre"
                                               Grid.Column="1"
                                               FontSize="12"
                                               Foreground="#334155"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />

                                    <TextBlock x:Name="TbActividad2Porcentaje"
                                               Grid.Column="2"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#1B365D" />

                                    <TextBlock x:Name="TbActividad2Maximo"
                                               Grid.Column="3"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#64748B" />

                                    <TextBlock x:Name="TbActividad2Calificacion"
                                               Grid.Column="4"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="#1B365D" />

                                </Grid>

                            </Border>

                            <!-- 3 -->
                            <Border Grid.Row="2"
                                    Margin="0,2"
                                    Background="White"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="8">

                                <Grid Margin="9,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="ACTIVIDAD 3"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#1B365D"
                                               VerticalAlignment="Center" />

                                    <TextBlock x:Name="TbActividad3Nombre"
                                               Grid.Column="1"
                                               FontSize="12"
                                               Foreground="#334155"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />

                                    <TextBlock x:Name="TbActividad3Porcentaje"
                                               Grid.Column="2"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#1B365D" />

                                    <TextBlock x:Name="TbActividad3Maximo"
                                               Grid.Column="3"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#64748B" />

                                    <TextBlock x:Name="TbActividad3Calificacion"
                                               Grid.Column="4"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="#1B365D" />

                                </Grid>

                            </Border>

                            <!-- 4 -->
                            <Border Grid.Row="3"
                                    Margin="0,2"
                                    Background="White"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="8">

                                <Grid Margin="9,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="ACTIVIDAD 4"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#1B365D"
                                               VerticalAlignment="Center" />

                                    <TextBlock x:Name="TbActividad4Nombre"
                                               Grid.Column="1"
                                               FontSize="12"
                                               Foreground="#334155"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />

                                    <TextBlock x:Name="TbActividad4Porcentaje"
                                               Grid.Column="2"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#1B365D" />

                                    <TextBlock x:Name="TbActividad4Maximo"
                                               Grid.Column="3"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#64748B" />

                                    <TextBlock x:Name="TbActividad4Calificacion"
                                               Grid.Column="4"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="#1B365D" />

                                </Grid>

                            </Border>

                        </Grid>

                        <!-- DATOS -->
                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <TextBlock Text="CLASES TOTALES:"
                                       FontSize="12"
                                       Foreground="#64748B" />

                            <TextBlock x:Name="TbNumeroClases"
                                       Text="0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#334155"
                                       Margin="5,0,20,0" />

                            <TextBlock Text="PORCENTAJE CONFIGURADO:"
                                       FontSize="12"
                                       Foreground="#64748B" />

                            <TextBlock x:Name="TbPorcentajeAcumulado"
                                       Text="0.0%"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#1B365D"
                                       Margin="5,0,0,0" />

                        </StackPanel>

                    </Grid>

                </Border>

            </Grid>

            <!-- BOTÓN -->
            <Grid Grid.Row="3">

                <Button
                    Width="110"
                    Height="34"
                    HorizontalAlignment="Right"
                    Click="Cerrar_Click"
                    Background="#F8FAFC"
                    Foreground="#1B365D"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Cursor="Hand"
                    Padding="10,8"
                    FontSize="13"
                    FontWeight="Bold">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border
                                x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="True" />

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver"
                                         Value="True">

                                    <Setter TargetName="Root"
                                            Property="Background"
                                            Value="#EFF6FF" />

                                    <Setter TargetName="Root"
                                            Property="BorderBrush"
                                            Value="#93C5FD" />

                                </Trigger>

                                <Trigger Property="IsPressed"
                                         Value="True">

                                    <Setter TargetName="Root"
                                            Property="Opacity"
                                            Value="0.88" />

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Button.Template>

                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <Viewbox
                            Width="16"
                            Height="16"
                            Margin="0,0,7,0"
                            VerticalAlignment="Center">

                            <Path
                                Fill="#1B365D"
                                Data="M4.707,3.293 L12,10.586 L19.293,3.293 L20.707,4.707 L13.414,12 L20.707,19.293 L19.293,20.707 L12,13.414 L4.707,20.707 L3.293,19.293 L10.586,12 L3.293,4.707 Z" />

                        </Viewbox>

                        <TextBlock
                            Text="CERRAR"
                            Foreground="#1B365D"
                            FontSize="13"
                            FontWeight="Bold"
                            VerticalAlignment="Center" />

                    </StackPanel>

                </Button>

            </Grid>

        </Grid>

    </Border>

</Window>