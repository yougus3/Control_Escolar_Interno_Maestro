<Window x:Class="Registro_de_Calificaciones_Jose_Ma._Morelos_y_Pavon.Views.Modals.PorcentajesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resumen de porcentajes"
        Height="460"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F1F5F9">

    <Window.Resources>

        <!-- ========================================================= -->
        <!-- BOTÓN AZUL                                                 -->
        <!-- ========================================================= -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#1B365D"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                                x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger
                                    Property="IsMouseOver"
                                    Value="True">

                                <Setter
                                        TargetName="Root"
                                        Property="Background"
                                        Value="#172F52"/>

                            </Trigger>

                            <Trigger
                                    Property="IsPressed"
                                    Value="True">

                                <Setter
                                        TargetName="Root"
                                        Property="Opacity"
                                        Value="0.85"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================================= -->
        <!-- COMBOBOX                                                   -->
        <!-- ========================================================= -->

        <Style x:Key="ParcialComboBoxStyle"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#0F172A"/>

            <Setter Property="BorderBrush"
                    Value="#CBD5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="8,0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>

    </Window.Resources>


    <Grid Margin="15">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- ========================================================= -->
        <!-- ENCABEZADO                                                  -->
        <!-- ========================================================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,12">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="170"/>

            </Grid.ColumnDefinitions>


            <TextBlock
                    Grid.Column="0"
                    Text="Resumen de porcentajes"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="#1B365D"
                    VerticalAlignment="Center"/>


            <StackPanel
                    Grid.Column="1">

                <TextBlock
                        Text="Parcial"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#64748B"
                        Margin="0,0,0,3"/>

                <ComboBox
                        x:Name="CmbParcial"
                        Style="{StaticResource ParcialComboBoxStyle}"
                        SelectionChanged="CmbParcial_SelectionChanged"/>

            </StackPanel>

        </Grid>


        <!-- ========================================================= -->
        <!-- CONTENIDO                                                  -->
        <!-- ========================================================= -->

        <Border
                Grid.Row="1"
                Background="White"
                BorderBrush="#D7DEE8"
                BorderThickness="1"
                CornerRadius="10"
                Padding="15">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- ACTIVIDAD 1                                        -->
                <!-- ================================================= -->

                <Border
                        Grid.Row="0"
                        Background="#F8FAFC"
                        BorderBrush="#D7DEE8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,7"
                        Margin="0,2">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="75"/>

                        </Grid.ColumnDefinitions>


                        <TextBlock
                                Grid.Column="0"
                                Text="ACTIVIDAD 1"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#1B365D"
                                VerticalAlignment="Center"/>


                        <TextBlock
                                Grid.Column="1"
                                x:Name="TbActividad1Nombre"
                                FontSize="12"
                                Foreground="#334155"
                                VerticalAlignment="Center"
                                Margin="12,0,5,0"
                                TextTrimming="CharacterEllipsis"/>


                        <TextBlock
                                Grid.Column="2"
                                x:Name="TbActividad1Porcentaje"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#1B365D"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"/>


                        <TextBlock
                                Grid.Column="3"
                                x:Name="TbActividad1Maximo"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#64748B"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="5,0,0,0"/>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- ACTIVIDAD 2                                        -->
                <!-- ================================================= -->

                <Border
                        Grid.Row="1"
                        Background="#F8FAFC"
                        BorderBrush="#D7DEE8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,7"
                        Margin="0,2">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="75"/>

                        </Grid.ColumnDefinitions>


                        <TextBlock
                                Grid.Column="0"
                                Text="ACTIVIDAD 2"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#1B365D"
                                VerticalAlignment="Center"/>


                        <TextBlock
                                Grid.Column="1"
                                x:Name="TbActividad2Nombre"
                                FontSize="12"
                                Foreground="#334155"
                                VerticalAlignment="Center"
                                Margin="12,0,5,0"
                                TextTrimming="CharacterEllipsis"/>


                        <TextBlock
                                Grid.Column="2"
                                x:Name="TbActividad2Porcentaje"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#1B365D"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"/>


                        <TextBlock
                                Grid.Column="3"
                                x:Name="TbActividad2Maximo"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#64748B"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="5,0,0,0"/>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- ACTIVIDAD 3                                        -->
                <!-- ================================================= -->

                <Border
                        Grid.Row="2"
                        Background="#F8FAFC"
                        BorderBrush="#D7DEE8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,7"
                        Margin="0,2">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="75"/>

                        </Grid.ColumnDefinitions>


                        <TextBlock
                                Grid.Column="0"
                                Text="ACTIVIDAD 3"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#1B365D"
                                VerticalAlignment="Center"/>


                        <TextBlock
                                Grid.Column="1"
                                x:Name="TbActividad3Nombre"
                                FontSize="12"
                                Foreground="#334155"
                                VerticalAlignment="Center"
                                Margin="12,0,5,0"
                                TextTrimming="CharacterEllipsis"/>


                        <TextBlock
                                Grid.Column="2"
                                x:Name="TbActividad3Porcentaje"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#1B365D"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"/>


                        <TextBlock
                                Grid.Column="3"
                                x:Name="TbActividad3Maximo"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#64748B"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="5,0,0,0"/>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- ACTIVIDAD 4                                        -->
                <!-- ================================================= -->

                <Border
                        Grid.Row="3"
                        Background="#F8FAFC"
                        BorderBrush="#D7DEE8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,7"
                        Margin="0,2">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="75"/>

                        </Grid.ColumnDefinitions>


                        <TextBlock
                                Grid.Column="0"
                                Text="ACTIVIDAD 4"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#1B365D"
                                VerticalAlignment="Center"/>


                        <TextBlock
                                Grid.Column="1"
                                x:Name="TbActividad4Nombre"
                                FontSize="12"
                                Foreground="#334155"
                                VerticalAlignment="Center"
                                Margin="12,0,5,0"
                                TextTrimming="CharacterEllipsis"/>


                        <TextBlock
                                Grid.Column="2"
                                x:Name="TbActividad4Porcentaje"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#1B365D"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"/>


                        <TextBlock
                                Grid.Column="3"
                                x:Name="TbActividad4Maximo"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#64748B"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="5,0,0,0"/>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- NÚMERO DE CLASES                                   -->
                <!-- ================================================= -->

                <Border
                        Grid.Row="5"
                        Background="#FFFFFF"
                        BorderBrush="#D7DEE8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8">

                    <Grid>

                        <TextBlock
                                Text="NÚMERO DE CLASES"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#334155"
                                VerticalAlignment="Center"/>


                        <TextBlock
                                x:Name="TbNumeroClases"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="#1B365D"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"/>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- PORCENTAJE ACUMULADO                               -->
                <!-- ================================================= -->

                <Border
                        Grid.Row="7"
                        Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,9">

                    <Grid>

                        <TextBlock
                                Text="PORCENTAJE ACUMULADO"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="#1B365D"
                                VerticalAlignment="Center"/>


                        <TextBlock
                                x:Name="TbPorcentajeAcumulado"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#1B365D"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"/>

                    </Grid>

                </Border>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- CERRAR                                                     -->
        <!-- ========================================================= -->

        <StackPanel
                Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,15,0,0">

            <Button
                    Content="Cerrar"
                    Width="100"
                    Height="36"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Cerrar_Click"/>

        </StackPanel>

    </Grid>

</Window>
