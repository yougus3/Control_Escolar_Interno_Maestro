<Window x:Class="Registro_de_Calificaciones_Jose_Ma._Morelos_y_Pavon.Views.Modals.GraficasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Evaluación del grupo"
        Width="1100"
        Height="650"
        MinWidth="1100"
        MinHeight="650"
        MaxWidth="1100"
        MaxHeight="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F1F5F9"
        Loaded="GraficasWindow_Loaded">

    <Window.Resources>

        <!-- ========================================================= -->
        <!-- BOTÓN BLANCO                                               -->
        <!-- ========================================================= -->

        <Style x:Key="WhiteButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="White" />

            <Setter Property="Foreground"
                    Value="#1B365D" />

            <Setter Property="BorderBrush"
                    Value="#CBD5E1" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Padding"
                    Value="12,6" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#EFF6FF" />

                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="#93C5FD" />

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.85" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Border Margin="16"
            Background="White"
            CornerRadius="14">

        <Grid Margin="18">

            <Grid.RowDefinitions>

                <RowDefinition Height="58" />

                <RowDefinition Height="1" />

                <RowDefinition Height="*" />

                <RowDefinition Height="46" />

            </Grid.RowDefinitions>

            <!-- ===================================================== -->
            <!-- ENCABEZADO                                             -->
            <!-- ===================================================== -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="165" />

                    <ColumnDefinition Width="165" />

                    <ColumnDefinition Width="165" />

                    <ColumnDefinition Width="190" />

                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Evaluación del grupo"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="#1B365D" />

                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0">

                        <TextBlock Text="EVALUACIÓN:"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B" />

                        <TextBlock x:Name="TbEvaluacion"
                                   Text="PARCIAL 1"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#1B365D"
                                   Margin="6,0,0,0" />

                    </StackPanel>

                </StackPanel>

                <!-- ================================================= -->
                <!-- ALUMNOS EVALUADOS                                  -->
                <!-- ================================================= -->

                <Border Grid.Column="1"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,5"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="*" />

                            <RowDefinition Height="*" />

                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="ALUMNOS EVALUADOS"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />

                        <TextBlock x:Name="TbAlumnosEvaluados"
                                   Grid.Row="1"
                                   Text="0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#1B365D"
                                   Margin="0,0,0,5" />

                    </Grid>

                </Border>

                <!-- ================================================= -->
                <!-- APROBADOS                                          -->
                <!-- ================================================= -->

                <Border Grid.Column="2"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,5"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="*" />

                            <RowDefinition Height="*" />

                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="APROBADOS"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#64748B"
                                   TextAlignment="Center" />

                        <TextBlock x:Name="TbAprobados"
                                   Grid.Row="1"
                                   Text="0 (0.00%)"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#1B365D"
                                   Margin="0,0,0,5" />

                    </Grid>

                </Border>

                <!-- ================================================= -->
                <!-- REPROBADOS                                         -->
                <!-- ================================================= -->

                <Border Grid.Column="3"
                        Background="#FEF2F2"
                        BorderBrush="#FECACA"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,5"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="*" />

                            <RowDefinition Height="*" />

                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="REPROBADOS"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#991B1B"
                                   TextAlignment="Center" />

                        <TextBlock x:Name="TbReprobados"
                                   Grid.Row="1"
                                   Text="0 (0.00%)"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#DC2626"
                                   Margin="0,0,0,5" />

                    </Grid>

                </Border>

                <!-- ================================================= -->
                <!-- PROMEDIO                                            -->
                <!-- ================================================= -->

                <Border Grid.Column="4"
                        Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,5"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="70" />

                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="PROMEDIO"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#1B365D" />

                        <TextBlock x:Name="TbPromedio"
                                   Grid.Column="1"
                                   Text="--"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#1B365D" />

                    </Grid>

                </Border>

            </Grid>

            <Border Grid.Row="1"
                    Background="#E2E8F0" />

            <!-- ===================================================== -->
            <!-- CONTENIDO                                              -->
            <!-- ===================================================== -->

            <Grid Grid.Row="2"
                  Margin="0,12,0,8">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="400" />

                    <ColumnDefinition Width="14" />

                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>

                <!-- ================================================= -->
                <!-- GRÁFICA IZQUIERDA: PROMEDIO                       -->
                <!-- ================================================= -->

                <Border Grid.Column="0"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="34" />

                            <RowDefinition Height="*" />

                            <RowDefinition Height="38" />

                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">

                            <TextBlock Text="PROMEDIO DEL GRUPO"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#64748B" />

                            <TextBlock Text="Escala de 0 a 10"
                                       FontSize="11"
                                       Foreground="#94A3B8"
                                       Margin="0,2,0,0" />

                        </StackPanel>

                        <Canvas x:Name="CanvasPromedio"
                                Grid.Row="1"
                                SizeChanged="CanvasPromedio_SizeChanged"
                                Background="Transparent" />

                        <TextBlock x:Name="TbPromedioDetalle"
                                   Grid.Row="2"
                                   Text="Sin calificaciones numéricas"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="#64748B" />

                    </Grid>

                </Border>

                <!-- ================================================= -->
                <!-- SEPARADOR                                           -->
                <!-- ================================================= -->

                <Grid Grid.Column="1" />

                <!-- ================================================= -->
                <!-- GRÁFICA DERECHA: DISTRIBUCIÓN                      -->
                <!-- ================================================= -->

                <Border Grid.Column="2"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="34" />

                            <RowDefinition Height="*" />

                            <RowDefinition Height="30" />

                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">

                            <TextBlock Text="DISTRIBUCIÓN DE CALIFICACIONES"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#64748B" />

                            <TextBlock Text="Número de alumnos por calificación"
                                       FontSize="11"
                                       Foreground="#94A3B8"
                                       Margin="0,2,0,0" />

                        </StackPanel>

                        <Canvas x:Name="CanvasDistribucion"
                                Grid.Row="1"
                                SizeChanged="CanvasDistribucion_SizeChanged"
                                Background="Transparent" />

                        <TextBlock Grid.Row="2"
                                   Text="Las calificaciones decimales se agrupan por su valor truncado."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="#94A3B8" />

                    </Grid>

                </Border>

            </Grid>

            <!-- ===================================================== -->
            <!-- BOTÓN CERRAR                                           -->
            <!-- ===================================================== -->

            <Grid Grid.Row="3">

                <Button Width="110"
                        Height="34"
                        HorizontalAlignment="Right"
                        Style="{StaticResource WhiteButtonStyle}"
                        Click="Cerrar_Click">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <Viewbox Width="15"
                                 Height="15"
                                 Margin="0,0,7,0">

                            <Path
                                Fill="#1B365D"
                                Data="M4.707,3.293 L12,10.586 L19.293,3.293 L20.707,4.707 L13.414,12 L20.707,19.293 L19.293,20.707 L12,13.414 L4.707,20.707 L3.293,19.293 L10.586,12 L3.293,4.707 Z" />

                        </Viewbox>

                        <TextBlock Text="CERRAR"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#1B365D"
                                   VerticalAlignment="Center" />

                    </StackPanel>

                </Button>

            </Grid>

        </Grid>

    </Border>

</Window>