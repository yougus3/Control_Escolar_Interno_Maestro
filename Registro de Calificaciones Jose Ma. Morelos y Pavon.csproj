<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Aplicación WPF -->
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>

		<!-- Nombre / namespace -->
		<RootNamespace>Registro_de_Calificaciones_Jose_Ma._Morelos_y_Pavon</RootNamespace>

		<!-- Compilación -->
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Windows 32 bits -->
		<PlatformTarget>x86</PlatformTarget>
		<RuntimeIdentifier>win-x86</RuntimeIdentifier>

		<!-- Publicación independiente de .NET -->
		<SelfContained>true</SelfContained>

		<!-- Todo dentro de un solo EXE -->
		<PublishSingleFile>true</PublishSingleFile>

		<!-- Incluye las DLL nativas dentro del EXE -->
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

		<!-- Recursos -->
		<SatelliteResourceLanguages>none</SatelliteResourceLanguages>
		<NeutralLanguage>es-MX</NeutralLanguage>

		<!-- Icono -->
		<ApplicationIcon>logo.ico</ApplicationIcon>

		<!-- Plataformas disponibles en Visual Studio -->
		<Platforms>AnyCPU;x86</Platforms>

		<!-- Release limpio -->
		<DebugType>None</DebugType>
		<DebugSymbols>false</DebugSymbols>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="LiteDB" Version="5.0.13" />
		<PackageReference Include="QuestPDF" Version="2026.8.0" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Data\**\*">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Remove="logo.jpg" />

		<Content Include="logo.ico">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>

		<Resource Include="logo.jpg">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Resource>
	</ItemGroup>

</Project>