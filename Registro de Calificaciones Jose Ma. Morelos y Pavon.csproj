<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Aplicación WPF -->
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>

		<!-- Nombre / namespace -->
		<RootNamespace>Registro_de_Calificaciones_Jose_Ma._Morelos_y_Pavon</RootNamespace>

		<!-- Compilación -->
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Windows 32 bits portátil -->
		<PlatformTarget>x86</PlatformTarget>
		<RuntimeIdentifier>win-x86</RuntimeIdentifier>

		<!-- Publicación independiente de .NET -->
		<SelfContained>true</SelfContained>

		<!-- Todo dentro de un solo EXE puro -->
		<PublishSingleFile>true</PublishSingleFile>

		<!-- Incluye las DLL nativas de WebView2 dentro del EXE -->
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

		<!-- BLOQUEA LA CARPETA LATOFONT EXTERNA DE QUESTPDF -->
		<QuestPDF_Runtime_ExtractFonts>false</QuestPDF_Runtime_ExtractFonts>

		<!-- Recursos -->
		<SatelliteResourceLanguages>none</SatelliteResourceLanguages>
		<NeutralLanguage>es-MX</NeutralLanguage>

		<!-- Icono -->
		<ApplicationIcon>logo.ico</ApplicationIcon>

		<!-- Plataformas disponibles en Visual Studio -->
		<Platforms>AnyCPU;x86</Platforms>

		<!-- Release limpio -->
		<DebugType>None</DebugType>
		<DebugSymbols>false</DebugSymbols>
		<Version>2.2.1</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
		<PackageReference Include="QuestPDF" Version="2026.8.0" />
		<PackageReference Include="PdfSharpCore" Version="1.3.40" />
	</ItemGroup>

	<!-- Eliminamos por completo las instrucciones que antes clonaban o copiaban físicamente la carpeta Data -->
	<ItemGroup>
		<None Remove="logo.jpg" />
		<Content Include="logo.ico" />
		<Resource Include="logo.jpg" />
		<None Remove="Data\public.key" />
		<Resource Include="Data\public.key" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="configuracion_global.json" />
	</ItemGroup>

</Project>
