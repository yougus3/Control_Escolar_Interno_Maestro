<Window x:Class="Registro_de_Calificaciones_Jose_Ma._Morelos_y_Pavon.Views.Modals.PorcentajesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resumen de porcentajes" 
        Height="400" 
        Width="520" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize" 
        Background="#F1F5F9">

    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1B365D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Resumen de porcentajes y puntaje máximo esperado" 
                   FontSize="16" FontWeight="Bold" Foreground="#1B365D" Margin="0,0,0,10"/>

        <Border Grid.Row="1" Background="White" BorderBrush="#D7DEE8" BorderThickness="1" CornerRadius="8" Padding="20">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6">
                    <TextBlock Text="Suma total porcentajes (parcial actual):" FontWeight="SemiBold" Width="340"/>
                    <TextBlock x:Name="TbSumaPorcentajes" Text="0%" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,6">
                    <TextBlock Text="Máximo puntaje esperado (4 actividades x 3 parciales):" FontWeight="SemiBold" Width="340"/>
                    <TextBlock x:Name="TbMaxPuntaje" Text="0" FontWeight="Bold"/>
                </StackPanel>

                <TextBlock Margin="0,12,0,0" Foreground="#64748B">
                    Estos valores se calculan con las actividades activas en la evaluación actual. El máximo esperado suma los puntajes máximos y lo multiplica por 3 (tres parciales).
                </TextBlock>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cerrar" Width="100" Height="36" Style="{StaticResource PrimaryButtonStyle}" Click="Cerrar_Click"/>
        </StackPanel>
    </Grid>
</Window>
